rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // BASE PARTILHADA COM PERMISSOES POR CARGO
    //
    // A base e da empresa, nao de cada conta. O que limita cada pessoa sao as
    // permissoes gravadas no seu documento em /utilizadores/{uid}, atribuidas
    // no ecra de Utilizadores e cargos.
    //
    // As permissoes sao verificadas aqui, no servidor: esconder botoes na
    // aplicacao nao impede ninguem de chamar a base de dados diretamente.

    function autenticado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/utilizadores/$(request.auth.uid)).data;
    }

    function temPerfil() {
      return autenticado() && exists(/databases/$(database)/documents/utilizadores/$(request.auth.uid));
    }

    /** Conta ativa e com a permissao pedida. */
    function pode(permissao) {
      return temPerfil() && perfil().ativo == true && permissao in perfil().permissoes;
    }

    /**
     * Permissoes que uma conta se pode atribuir a si propria no primeiro acesso.
     *
     * Sem este limite, qualquer pessoa que se registasse podia criar o seu
     * documento ja com todas as permissoes e tornar-se administradora sozinha.
     * O primeiro administrador e atribuido de fora, nao pela propria conta.
     */
    function permissoesDeConsulta() {
      return ['clientes.ver', 'materiais.ver', 'servicos.ver', 'orcamentos.ver', 'relatorios.ver'];
    }

    // ---- Picagem de ponto
    // Quem gere funcionarios gere o ponto (igual a IMPLICITAS em lib/permissoes.ts)
    function gerePonto() {
      return pode('ponto.gerir') || pode('funcionarios.gerir');
    }

    function picador() {
      return pode('ponto.picar');
    }

    /** Conta de trabalhador criada pelo gestor: so pode picar. */
    function contaDeTrabalhador(dados) {
      return dados.cargo == 'trabalhador' && dados.permissoes == ['ponto.picar'];
    }

    function autoRegistoSeguro(uid) {
      return autenticado()
        && uid == request.auth.uid
        && request.resource.data.cargo == 'consulta'
        && request.resource.data.permissoes.hasOnly(permissoesDeConsulta());
    }

    match /utilizadores/{uid} {
      // Cada um le o seu perfil; quem gere utilizadores le todos
      allow get: if autenticado() && (uid == request.auth.uid || pode('utilizadores.gerir'));
      allow list: if autenticado();

      // O proprio cria o seu registo no primeiro acesso, mas so como Consulta.
      // Atribuir cargos com mais permissoes exige quem gere utilizadores.
      allow create: if autoRegistoSeguro(uid) || pode('utilizadores.gerir')
        || (gerePonto() && contaDeTrabalhador(request.resource.data));
      allow update: if pode('utilizadores.gerir')
        || (gerePonto() && contaDeTrabalhador(resource.data) && contaDeTrabalhador(request.resource.data))
        || (autenticado() && uid == request.auth.uid
            && request.resource.data.cargo == resource.data.cargo
            && request.resource.data.permissoes == resource.data.permissoes);
      allow delete: if pode('utilizadores.gerir');
    }

    match /clientes/{docId} {
      allow read: if pode('clientes.ver');
      allow write: if pode('clientes.gerir');
    }

    match /funcionarios/{docId} {
      allow read: if pode('funcionarios.ver');
      allow write: if pode('funcionarios.gerir');
    }

    match /materiais/{docId} {
      allow read: if pode('materiais.ver');
      allow write: if pode('materiais.gerir');
    }

    // Historico do estoque: quem gere produtos regista entradas e saidas.
    // Os movimentos nao se editam nem apagam - um erro corrige-se com outro
    // movimento (ou um ajuste), para o historico explicar sempre o saldo.
    match /movimentosEstoque/{docId} {
      allow read: if pode('materiais.ver');
      allow create: if pode('materiais.gerir');
      allow update, delete: if false;
    }

    // Funcoes de mao de obra: o orcamentista precisa do preco/hora para montar
    // propostas, por isso le quem ve orcamentos; so quem gere pessoal altera.
    match /funcoes/{docId} {
      allow read: if pode('orcamentos.ver') || pode('funcionarios.ver');
      allow write: if pode('funcionarios.gerir');
    }

    match /material-categories/{docId} {
      allow read: if pode('materiais.ver');
      allow write: if pode('materiais.gerir');
    }

    match /categorias/{docId} {
      allow read: if pode('materiais.ver');
      allow write: if pode('materiais.gerir');
    }

    match /servicos/{docId} {
      allow read: if pode('servicos.ver');
      allow write: if pode('servicos.gerir');
    }

    match /orcamentos/{docId} {
      allow read: if pode('orcamentos.ver');
      allow create: if pode('orcamentos.criar');
      allow delete: if pode('orcamentos.apagar');
      // Editar, submeter, aprovar ou cancelar: basta uma das permissoes de
      // escrita. A fase concreta e validada na aplicacao, que conhece a
      // transicao pretendida.
      allow update: if pode('orcamentos.editar')
        || pode('orcamentos.submeter')
        || pode('orcamentos.aprovar')
        || pode('orcamentos.cancelar')
        || pode('orcamentos.custosObra');
    }

    // ---------------------------------------------------------- Obra

    // Contas a receber e a pagar: custo e margem sao informacao interna
    match /contas/{docId} {
      allow read: if pode('orcamentos.verCusto');
      allow write: if pode('orcamentos.custosObra') || pode('orcamentos.aprovar');
    }

    // Autos de medicao: quem lanca custos cria; aprovar e um acto de quem aprova
    match /autosMedicao/{docId} {
      allow read: if pode('orcamentos.ver');
      allow create, delete: if pode('orcamentos.custosObra');
      allow update: if pode('orcamentos.custosObra') || pode('orcamentos.aprovar');
    }

    // Livro de ponto e faturas de fornecedor: registam-se pendentes e aprovam-se
    match /registosHoras/{docId} {
      allow read: if pode('orcamentos.verCusto') || pode('orcamentos.custosObra') || gerePonto();
      allow create, delete: if pode('orcamentos.custosObra') || pode('orcamentos.aprovar');
      allow update: if pode('orcamentos.aprovar');
      // Horas vindas das picagens: o gestor do ponto envia-as pendentes; quem aprova, aprova
      allow create, update: if gerePonto()
        && request.resource.data.origem == 'picagem'
        && request.resource.data.estado == 'pendente'
        && (resource == null || resource.data.estado == 'pendente');
    }

    match /faturasFornecedor/{docId} {
      allow read: if pode('orcamentos.verCusto') || pode('orcamentos.custosObra');
      allow create, delete: if pode('orcamentos.custosObra');
      allow update: if pode('orcamentos.aprovar') || pode('orcamentos.custosObra');
    }

    // Diario de obra e garantias: quem acompanha a obra
    match /rdos/{docId} {
      allow read: if pode('orcamentos.ver');
      allow write: if pode('orcamentos.custosObra');
    }

    match /garantias/{docId} {
      allow read: if pode('orcamentos.ver');
      allow write: if pode('orcamentos.custosObra') || pode('orcamentos.editar');
    }

    // Cotacoes a fornecedores: e compra de material
    match /cotacoes/{docId} {
      allow read: if pode('materiais.ver');
      allow write: if pode('materiais.gerir');
    }

    // Portal do cliente: leitura publica de UM documento por quem tem o link
    // (o id e um token aleatorio). Listar continua fechado, para ninguem
    // descobrir os portais dos outros clientes.
    match /portal/{token} {
      allow get: if true;
      allow list: if pode('orcamentos.ver');
      allow write: if pode('orcamentos.editar') || pode('orcamentos.aprovar');
    }

    match /termos_servico/{docId} {
      allow read: if autenticado();
      allow write: if pode('configuracoes.gerir');
    }

    match /configuracoes/{docId} {
      allow read: if autenticado();
      allow write: if pode('configuracoes.gerir');
    }

    // Numero do funcionario -> conta. Lido antes do login (so um de cada vez:
    // nao se consegue listar os numeros existentes).
    match /acessosPonto/{numero} {
      allow get: if true;
      allow list: if gerePonto();
      allow write: if gerePonto();
    }

    match /pontoConfig/{docId} {
      allow read: if autenticado();
      allow write: if gerePonto();
    }

    // Obras onde se pode picar: so numero, nome e local, sem valores
    match /obrasPonto/{docId} {
      allow read: if picador() || gerePonto();
      allow write: if gerePonto();
    }

    // Picagens: nunca se editam nem apagam. O trabalhador so cria as suas,
    // com a hora do servidor; o gestor cria correcoes e anulacoes, com motivo.
    match /picagens/{docId} {
      allow read: if gerePonto() || (picador() && resource.data.uid == request.auth.uid);
      allow create: if (picador()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.funcionarioId == perfil().funcionarioId
          && request.resource.data.origem == 'app'
          && request.resource.data.hora == request.time)
        || (gerePonto()
          && request.resource.data.origem in ['correcao', 'anulacao']
          && request.resource.data.motivo is string
          && request.resource.data.motivo.size() > 0);
      allow update, delete: if false;
    }

    // Ferias, faltas e correcoes. O trabalhador cria os seus (pendentes) e
    // so os pode cancelar enquanto pendentes; decidir e do gestor.
    match /pedidosPonto/{docId} {
      allow read: if gerePonto() || (picador() && resource.data.uid == request.auth.uid);
      allow create: if picador()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.funcionarioId == perfil().funcionarioId
        && request.resource.data.estado == 'pendente';
      allow update: if gerePonto()
        || (picador() && resource.data.uid == request.auth.uid
            && resource.data.estado == 'pendente'
            && request.resource.data.estado == 'cancelado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'updatedAt']));
      allow delete: if false;
    }

    // Tudo o resto continua fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
