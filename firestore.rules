rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // BASE PARTILHADA COM PERMISSOES POR CARGO
    //
    // A base e da empresa, nao de cada conta. O que limita cada pessoa sao as
    // permissoes gravadas no seu documento em /utilizadores/{uid}, atribuidas
    // no ecra de Utilizadores e cargos.
    //
    // As permissoes sao verificadas aqui, no servidor: esconder botoes na
    // aplicacao nao impede ninguem de chamar a base de dados diretamente.

    function autenticado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/utilizadores/$(request.auth.uid)).data;
    }

    function temPerfil() {
      return autenticado() && exists(/databases/$(database)/documents/utilizadores/$(request.auth.uid));
    }

    /** Conta ativa e com a permissao pedida. */
    function pode(permissao) {
      return temPerfil() && perfil().ativo == true && permissao in perfil().permissoes;
    }

    /**
     * Permissoes que uma conta se pode atribuir a si propria no primeiro acesso.
     *
     * Sem este limite, qualquer pessoa que se registasse podia criar o seu
     * documento ja com todas as permissoes e tornar-se administradora sozinha.
     * O primeiro administrador e atribuido de fora, nao pela propria conta.
     */
    function permissoesDeConsulta() {
      return ['clientes.ver', 'materiais.ver', 'servicos.ver', 'orcamentos.ver', 'relatorios.ver'];
    }

    function autoRegistoSeguro(uid) {
      return autenticado()
        && uid == request.auth.uid
        && request.resource.data.cargo == 'consulta'
        && request.resource.data.permissoes.hasOnly(permissoesDeConsulta());
    }

    match /utilizadores/{uid} {
      // Cada um le o seu perfil; quem gere utilizadores le todos
      allow get: if autenticado() && (uid == request.auth.uid || pode('utilizadores.gerir'));
      allow list: if autenticado();

      // O proprio cria o seu registo no primeiro acesso, mas so como Consulta.
      // Atribuir cargos com mais permissoes exige quem gere utilizadores.
      allow create: if autoRegistoSeguro(uid) || pode('utilizadores.gerir');
      allow update: if pode('utilizadores.gerir')
        || (autenticado() && uid == request.auth.uid
            && request.resource.data.cargo == resource.data.cargo
            && request.resource.data.permissoes == resource.data.permissoes);
      allow delete: if pode('utilizadores.gerir');
    }

    match /clientes/{docId} {
      allow read: if pode('clientes.ver');
      allow write: if pode('clientes.gerir');
    }

    match /funcionarios/{docId} {
      allow read: if pode('funcionarios.ver');
      allow write: if pode('funcionarios.gerir');
    }

    match /materiais/{docId} {
      allow read: if pode('materiais.ver');
      allow write: if pode('materiais.gerir');
    }

    match /material-categories/{docId} {
      allow read: if pode('materiais.ver');
      allow write: if pode('materiais.gerir');
    }

    match /categorias/{docId} {
      allow read: if pode('materiais.ver');
      allow write: if pode('materiais.gerir');
    }

    match /servicos/{docId} {
      allow read: if pode('servicos.ver');
      allow write: if pode('servicos.gerir');
    }

    match /orcamentos/{docId} {
      allow read: if pode('orcamentos.ver');
      allow create: if pode('orcamentos.criar');
      allow delete: if pode('orcamentos.apagar');
      // Editar, submeter, aprovar ou cancelar: basta uma das permissoes de
      // escrita. A fase concreta e validada na aplicacao, que conhece a
      // transicao pretendida.
      allow update: if pode('orcamentos.editar')
        || pode('orcamentos.submeter')
        || pode('orcamentos.aprovar')
        || pode('orcamentos.cancelar');
    }

    match /termos_servico/{docId} {
      allow read: if autenticado();
      allow write: if pode('configuracoes.gerir');
    }

    match /configuracoes/{docId} {
      allow read: if autenticado();
      allow write: if pode('configuracoes.gerir');
    }

    // Tudo o resto continua fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
